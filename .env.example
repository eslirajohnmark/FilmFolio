APP_NAME=FilmFolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. "log" writes emails to storage/logs/laravel.log (nothing is sent).
# For local testing with Mailpit (bundled with Laragon): set MAIL_MAILER=smtp,
# MAIL_HOST=127.0.0.1, MAIL_PORT=1025 and leave MAIL_USERNAME / MAIL_PASSWORD
# empty. Every email is caught and shown at http://localhost:8025.
# For real emails with Gmail: turn on 2-Step Verification, create an App
# Password at https://myaccount.google.com/apppasswords, fill in
# MAIL_USERNAME / MAIL_PASSWORD / MAIL_FROM_ADDRESS with that Gmail account,
# then set MAIL_MAILER=failover (sends via Gmail; if that fails, e.g. no
# internet, the email goes to the log instead of showing an error).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local only: after requesting a password reset, send the member to this
# Mailpit inbox (e.g. http://localhost:8025) to open the email. Leave empty
# to show the usual "check your inbox" message instead.
MAILPIT_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500

# Administrator created by `php artisan db:seed` (leave ADMIN_PASSWORD empty to generate one)
ADMIN_NAME=Administrator
ADMIN_USERNAME=Admin
ADMIN_EMAIL=admin@filmfolio.com
ADMIN_PASSWORD=
