APP_NAME=FilmFolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Docker uses its own bundled MySQL by default. To make it use the MySQL server above
# instead (one shared database), uncomment this (":" instead of ";" on macOS/Linux):
# COMPOSE_FILE="docker-compose.yml;docker-compose.host-db.yml"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail is sent through Resend's HTTP API: get a key at https://resend.com/api-keys and
# put it in Resend_API_key. "failover" falls back to storage/logs/laravel.log if Resend
# can't be reached or refuses an email. Until you verify a domain at resend.com/domains,
# the sender must be onboarding@resend.dev and Resend only delivers to your own address.
# Set MAIL_MAILER=log to write every email to the log instead of sending it.
MAIL_MAILER=failover
MAIL_FAILOVER_MAILERS=resend-api,log
Resend_API_key=
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500

# Administrator created by `php artisan db:seed` (leave ADMIN_PASSWORD empty to generate one)
ADMIN_NAME=Administrator
ADMIN_USERNAME=Admin
ADMIN_EMAIL=admin@filmfolio.com
ADMIN_PASSWORD=
