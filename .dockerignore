# Secrets and local-only files: never baked into the image
.env
.env.*
!.env.example
storage/app/backups

# Uploads are mounted from the host at runtime, not copied into the image
storage/app/public/*
!storage/app/public/.gitignore

# Rebuilt inside the image
vendor
node_modules
public/build
public/hot
public/storage
bootstrap/cache/*.php

# Runtime clutter
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing
.phpunit.result.cache

# Development tooling
.git
.github
.claude
.ai
.idea
.vscode
tests
phpunit.xml
docker-compose*.yml
Dockerfile
.dockerignore
